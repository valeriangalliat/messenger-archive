{
  "manifest_version": 3,
  "name": "Messenger Archive",
  "version": "0.2.0",
  "description": "Save your Messenger conversations and attachments.",
  "permissions": ["scripting", "downloads", "unlimitedStorage"],
  "host_permissions": [
    "https://www.messenger.com/*",
    "https://messenger.com/*",
    "https://www.facebook.com/messages/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "action": { "default_title": "Open Messenger Archive" },
  "browser_specific_settings": {
    "gecko": {
      "id": "messenger-archive@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
